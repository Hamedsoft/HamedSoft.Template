@using HamedSoft.Template.Application.Contracts.Users
@model IReadOnlyList<UserListItem>
@{
    ViewData["Title"] = "لیست کاربران";
}
<div class="row justify-content-center">
    <div class="card col-md-12">

        <div class="card-header">
            <h3 class="card-title">@ViewData["Title"]</h3>
        </div>
        <div class="card-body">
            <div class="panel panel-primary">
                <div class=" tab-menu-heading">
                    <div class="tabs-menu1">
                        <!-- Tabs -->
                        <ul class="nav panel-tabs">
                            <li>
                                <a href="#active" class="active" data-bs-toggle="tab">
                                    <span class="fa fa-check me-2 text-success"></span>
                                    کاربران فعال
                                </a>
                            </li>

                            <li>
                                <a href="#deactive" data-bs-toggle="tab">
                                    <span class="fa fa-close me-2 text-danger"></span>
                                    کاربران غیر فعال
                                </a>
                            </li>

                            <li>
                                <a href="#Locked" data-bs-toggle="tab">
                                    <span class="fa fa-lock me-2  text-warning"></span>
                                    کاربران مسدود
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="panel-body tabs-menu-body">
                    <div class="tab-content">
                        <div class="tab-pane active" id="active">
                            <div class="table-responsive">
                                <table class="table border text-nowrap text-md-nowrap table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th>نام کاربر</th>
                                            <th>نام کاربری</th>
                                            <th>نقش</th>
                                            <th>موبایل</th>
                                            <th>ایمیل</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in Model.Where(m => m.IsActive))
                                        {
                                            <tr>
                                                <td>@string.Concat(user.UserProfile.FirstName, " ", user.UserProfile.LastName)</td>
                                                <td>@user.UserName</td>
                                                <td>@string.Join(", ", user.Roles)</td>
                                                <td>@user.UserProfile.PhoneNumber</td>
                                                <td>@user.UserProfile.Email</td>
                                                <td>
                                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-warning"><i class="fa fa fa-pencil me-2"></i>ویرایش</a>
                                                    <a asp-action="Roles" asp-route-userId="@user.UserId" class="btn btn-sm btn-primary"><i class="fa fa fa-users me-2"></i>نقش ها</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane" id="deactive">
                            <div class="table-responsive">
                                <table class="table border text-nowrap text-md-nowrap table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th>نام کاربر</th>
                                            <th>نام کاربری</th>
                                            <th>نقش</th>
                                            <th>موبایل</th>
                                            <th>ایمیل</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in Model.Where(m => !m.IsActive))
                                        {
                                            <tr>
                                                <td>@string.Concat(user.UserProfile.FirstName, " ", user.UserProfile.LastName)</td>
                                                <td>@user.UserName</td>
                                                <td>@string.Join(", ", user.Roles)</td>
                                                <td>@user.UserProfile.PhoneNumber</td>
                                                <td>@user.UserProfile.Email</td>
                                                <td>
                                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-warning"><i class="fa fa fa-pencil me-2"></i>ویرایش</a>
                                                    <a asp-action="Roles" asp-route-userId="@user.UserId" class="btn btn-sm btn-primary"><i class="fa fa fa-users me-2"></i>نقش ها</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane" id="Locked">
                            <div class="table-responsive">
                                <table class="table border text-nowrap text-md-nowrap table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th>نام کاربر</th>
                                            <th>نام کاربری</th>
                                            <th>نقش</th>
                                            <th>موبایل</th>
                                            <th>ایمیل</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in Model.Where(mbox => mbox.IsLocked))
                                        {
                                            <tr>
                                                <td>@string.Concat(user.UserProfile.FirstName, " ", user.UserProfile.LastName)</td>
                                                <td>@user.UserName</td>
                                                <td>@string.Join(", ", user.Roles)</td>
                                                <td>@user.UserProfile.PhoneNumber</td>
                                                <td>@user.UserProfile.Email</td>
                                                <td>
                                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-warning"><i class="fa fa fa-pencil me-2"></i>ویرایش</a>
                                                    <a asp-action="Roles" asp-route-userId="@user.UserId" class="btn btn-sm btn-primary"><i class="fa fa fa-users me-2"></i>نقش ها</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
