@using HamedSoft.Template.Application.Common.Paging
@using HamedSoft.Template.Application.Contracts.Users
@model HamedSoft.Template.Web.ViewModels.Users.UsersIndexViewModel
@{
    ViewData["Title"] = "لیست کاربران";
}

<div class="row justify-content-center">
    <div class="card col-md-12">

        <div class="card-header">
            <h3 class="card-title">@ViewData["Title"]</h3>
        </div>
        <form asp-action="Index" method="get" class="mb-4">
            <div class="row align-items-end pt-2">

                <div class="col-md-5">
                    <a asp-action="Index" class="form-label text-decoration-none mb-1 ms-5" title="حذف فیلتر">جستجو</a>
                    <div class="input-group ms-5 ">
                        <input type="text"
                               class="form-control"
                               name="search"
                               value="@Model.Search"
                               placeholder="نام، نام خانوادگی، نام کاربری، موبایل یا ایمیل"
                               autocomplete="off"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                        <button class="btn btn-light" type="submit" id="button-addon1"><i class="fe fe-search" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>
        </form>
        <div class="card-body pt-0">
            <div class="panel panel-primary">
                <div class="tab-menu-heading">
                    <div class="tabs-menu1">
                        <ul class="nav panel-tabs">
                            <li>
                                <a href="#active"
                                   class="@(Model.ActiveTab == "active" ? "active" : "")"
                                   data-bs-toggle="tab">

                                    <span class="fa fa-check me-2 text-success"></span>
                                    کاربران فعال

                                </a>
                            </li>

                            <li>
                                <a href="#deactive"
                                   class="@(Model.ActiveTab == "deactive" ? "active" : "")"
                                   data-bs-toggle="tab">

                                    <span class="fa fa-close me-2 text-danger"></span>
                                    کاربران غیر فعال

                                </a>
                            </li>

                            <li>
                                <a href="#Locked"
                                   class="@(Model.ActiveTab == "locked" ? "active" : "")"
                                   data-bs-toggle="tab">

                                    <span class="fa fa-lock me-2 text-warning"></span>
                                    کاربران مسدود

                                </a>
                            </li>

                        </ul>

                    </div>
                </div>

                <div class="panel-body tabs-menu-body">

                    <div class="tab-content">

                        <!-- Active -->
                        <div class="tab-pane @(Model.ActiveTab == "active" ? "active" : "")"
                             id="active">

                            @await Html.PartialAsync(
                            "~/Views/Users/Partials/_UserTable.cshtml",
                                                        Model.ActiveUsers.Items)

                            @await Html.PartialAsync(
                                                        "_Pagination",
                                                        Model.ActivePagination)
                        </div>

                        <!-- Inactive -->
                        <div class="tab-pane @(Model.ActiveTab == "deactive" ? "active" : "")"
                             id="deactive">

                            @await Html.PartialAsync(
                                                        "~/Views/Users/Partials/_UserTable.cshtml",
                                                        Model.InactiveUsers.Items)

                            @await Html.PartialAsync(
                                                        "_Pagination",
                                                        Model.InactivePagination)
                        </div>


                        <!-- Locked -->
                        <div class="tab-pane @(Model.ActiveTab == "locked" ? "active" : "")"
                             id="Locked">

                            @await Html.PartialAsync(
                                                        "~/Views/Users/Partials/_UserTable.cshtml",
                                                        Model.LockedUsers.Items)

                            @await Html.PartialAsync(
                                                        "_Pagination",
                                                        Model.LockedPagination)
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
    <script>
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function (tab) {
            tab.addEventListener('shown.bs.tab', function (event) {

                const target = event.target.getAttribute('href');
                const tabName = target.replace('#', '');

                const url = new URL(window.location.href);

                url.searchParams.set('activeTab', tabName);

                history.replaceState(null, '', url);
            });
        });
    </script>
</div>