@model HamedSoft.Template.Web.ViewModels.Users.UserRolesViewModel

@{
    ViewData["Title"] = "Assign Roles";
}

<div class="card">

    <div class="card-header">
        <h3>Roles - @Model.UserName</h3>
    </div>

    <div class="card-body">

        <form asp-action="Roles" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="UserId" type="hidden" />
            <input asp-for="UserName" type="hidden" />

            <table class="table">

                <thead>

                    <tr>
                        <th>Role</th>
                        <th>Selected</th>
                    </tr>

                </thead>

                <tbody>

                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <tr>

                            <td>

                                @Model.Roles[i].RoleName

                                <input asp-for="Roles[i].RoleName"
                                       type="hidden" />

                            </td>

                            <td>

                                <input asp-for="Roles[i].Selected"
                                       class="form-check-input" />

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <button class="btn btn-primary"
                    type="submit">

                Save

            </button>

        </form>

    </div>

</div>