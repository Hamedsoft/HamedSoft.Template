@model HamedSoft.Template.Web.ViewModels.Users.UserRolesViewModel


<form asp-action="UpdateRoles"
      method="post">

    @Html.AntiForgeryToken()


    <input type="hidden"
           asp-for="UserId" />


    <div class="row">

        @for (var i = 0; i < Model.Roles.Count; i++)
        {
            <div class="col-md-4 mb-2">

                <div class="form-check">

                    <input type="hidden"
                           asp-for="Roles[i].RoleId" />

                    <input type="hidden"
                           asp-for="Roles[i].RoleName" />


                    <input class="form-check-input"
                           asp-for="Roles[i].Selected" />


                    <label class="form-check-label">
                        @Model.Roles[i].RoleName
                    </label>

                </div>

            </div>
        }

    </div>


    <button type="submit"
            class="btn btn-primary mt-3">

        ذخیره نقش‌ها

    </button>

</form>