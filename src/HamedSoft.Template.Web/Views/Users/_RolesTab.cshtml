@model HamedSoft.Template.Web.ViewModels.Users.UserRolesViewModel
<form asp-action="UpdateRoles" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <div class="card-title">لیست نقش های موجود</div>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    @for (var i = 0; i < Model.Roles.Count; i++)
                    {
                        <input type="hidden" asp-for="Roles[i].RoleId" />
                        <input type="hidden" asp-for="Roles[i].RoleName" />
                        <li class="list-group-item">
                            <label class="custom-switch form-switch mb-0">
                                <input type="checkbox" class="custom-switch-input" asp-for="Roles[i].Selected" />
                                <span class="custom-switch-indicator"></span>
                                <span class="form-check-label ms-2">@Model.Roles[i].RoleName</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-success">ذخیره اطلاعات</button>
                <a class="btn btn-default" asp-action="index">بازگشت</a>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-6"> </div>
    </div>
</form>

