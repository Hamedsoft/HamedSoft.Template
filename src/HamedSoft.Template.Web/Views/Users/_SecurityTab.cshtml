@model HamedSoft.Template.Web.ViewModels.Users.UserSecurityViewModel


<div class="card">

    <div class="card-body">


        <h5 class="mb-4">
            تنظیمات امنیتی:
            @Model.UserName
        </h5>


        <!-- Active Status -->

        <form asp-action="UpdateStatus"
              method="post"
              class="mb-4">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="UserId"
                   value="@Model.UserId" />


            <div class="form-check form-switch">

                <input class="form-check-input"
                       type="checkbox"
                       name="IsActive"
                       value="true"
                       @(Model.IsActive ? "checked" : "") />

                <label class="form-check-label">

                    کاربر فعال است

                </label>

            </div>


            <button class="btn btn-primary mt-2"
                    type="submit">

                ذخیره وضعیت

            </button>

        </form>



        <hr />



        <!-- Lock -->

        <div class="mb-4">

            @if (Model.IsLocked)
            {
                <form asp-action="Unlock"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="userId"
                           value="@Model.UserId" />


                    <button class="btn btn-success">

                        باز کردن قفل کاربر

                    </button>

                </form>
            }
            else
            {
                <form asp-action="Lock"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="userId"
                           value="@Model.UserId" />


                    <button class="btn btn-danger">

                        قفل کردن کاربر

                    </button>

                </form>
            }

        </div>



        <hr />



        <!-- Reset Password -->


        <form asp-action="ResetPassword"
              method="post">


            @Html.AntiForgeryToken()


            <input type="hidden"
                   name="UserId"
                   value="@Model.UserId" />


            <div class="mb-3">

                <label class="form-label">
                    رمز عبور جدید
                </label>


                <input type="password"
                       name="NewPassword"
                       class="form-control"
                       required />

            </div>



            <button class="btn btn-warning">

                تغییر رمز عبور

            </button>


        </form>


    </div>

</div>