@model HamedSoft.Template.Web.ViewModels.Users.EditUserViewModel

@{
    ViewData["Title"] = "ویرایش کاربر";
}

<div class="card">

    <div class="card-header">
        <h5>
            ویرایش کاربر:
            @Model.Profile.UserName
        </h5>
    </div>


    <div class="card-body">

        <ul class="nav nav-tabs" id="userEditTabs" role="tablist">

            <li class="nav-item" role="presentation">
                <button class="nav-link active"
                        data-bs-toggle="tab"
                        data-bs-target="#profile"
                        type="button">
                    اطلاعات کاربر
                </button>
            </li>


            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        data-bs-toggle="tab"
                        data-bs-target="#roles"
                        type="button">
                    نقش‌ها
                </button>
            </li>


            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        data-bs-toggle="tab"
                        data-bs-target="#security"
                        type="button">
                    امنیت
                </button>
            </li>

        </ul>


        <div class="tab-content mt-3">


            <!-- Profile Tab -->
            <div class="tab-pane fade show active"
                 id="profile">

                @await Html.PartialAsync(
                "_ProfileTab",
                                Model.Profile)

            </div>



            <!-- Roles Tab -->
            <div class="tab-pane fade"
                 id="roles">

                @await Html.PartialAsync(
                                "_RolesTab",
                                Model.Roles)

            </div>



            <!-- Security Tab -->
            <div class="tab-pane fade"
                 id="security">

                @await Html.PartialAsync(
                                "_SecurityTab",
                                Model.Security)

            </div>


        </div>

    </div>

</div>