@model HamedSoft.Template.Web.ViewModels.Users.EditUserViewModel
@{
    ViewData["Title"] = "ویرایش کاربر";
}
<div class="col-xl-6">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
               ویرایش اطلاعات کاربر (@Model.Profile.UserName)
            </h3>
        </div>
        <div class="card-body">
            <div class="panel panel-primary">
                <div class="tab-menu-heading tab-menu-heading-boxed">
                    <div class="tabs-menu-boxed">
                        <!-- Tabs -->
                        <ul class="nav panel-tabs">
                            <li><a href="#profile" class="active" data-bs-toggle="tab">اطلاعات کاربر</a></li>
                            <li><a href="#roles" data-bs-toggle="tab">نقش‌ها</a></li>
                            <li><a href="#security" data-bs-toggle="tab">امنیت</a></li>
                        </ul>
                    </div>
                </div>
                <div class="panel-body tabs-menu-body">
                    <!-- Profile Tab -->
                    <div class="tab-content">
                        <div class="tab-pane active" id="profile">
                            @await Html.PartialAsync("_ProfileTab", Model.Profile)
                        </div>
                        <!-- Roles Tab -->
                        <div class="tab-pane" id="roles">
                            @await Html.PartialAsync("_RolesTab", Model.Roles)
                        </div>
                        <!-- Security Tab -->
                        <div class="tab-pane" id="security">
                            @await Html.PartialAsync("_SecurityTab", Model.Security)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
