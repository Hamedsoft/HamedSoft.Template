@model HamedSoft.Template.Web.ViewModels.Settings.SettingsIndexViewModel

@{
    ViewData["Title"] = "Settings";
}

<div id="settings-section-test"
     class="settings-container"
     data-settings-module="Treasury"
     data-settings-feature="ElectronicTransfer"
     data-settings-category="System"
     data-settings-section-url="@Url.Action("Section", "Settings")"
     data-settings-update-url="@Url.Action("Update", "Settings")">

    @Html.AntiForgeryToken()

    <div class="text-muted">
        Loading settings...
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/settings/settings.js"></script>
}