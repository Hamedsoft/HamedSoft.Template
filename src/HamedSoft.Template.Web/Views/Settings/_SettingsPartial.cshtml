@using HamedSoft.Template.Domain.Settings
@model HamedSoft.Template.Web.Models.Settings.SettingSectionViewModel
<form style="display:none">
    @Html.AntiForgeryToken()
</form>
<div class="settings-section"
     data-module="@Model.Module"
     data-feature="@Model.Feature"
     data-category="@Model.Category">

    <div class="mb-4">
        <h5 class="mb-1">تنظیمات</h5>

        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
            <div class="text-muted small">
                @Model.Category
            </div>
        }
    </div>
    
    @if (Model.Settings.Count == 0)
    {
        <div class="alert alert-light border">
            تنظیماتی برای این بخش تعریف نشده است.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var setting in Model.Settings)
            {
                <div class="col-12">

                    <div class="card border shadow-none">
                        <div class="card-body">

                            <div class="row align-items-center">

                                <div class="col-lg-4 mb-3 mb-lg-0">

                                    <label class="form-label fw-semibold">
                                        @setting.Key

                                        @if (setting.IsRequired)
                                        {
                                            <span class="text-danger">*</span>
                                        }

                                        @if (setting.IsSecret)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">
                                                Secret
                                            </span>
                                        }
                                    </label>

                                    @if (!string.IsNullOrWhiteSpace(setting.Description))
                                    {
                                        <div class="text-muted small">
                                            @setting.Description
                                        </div>
                                    }

                                </div>

                                <div class="col-lg-6">

                                    @switch (setting.ValueType)
                                    {
                                        case SettingValueType.String:
                                            if (setting.IsSecret)
                                            {
                                                <div class="input-group">
                                                    <input type="password"
                                                           class="form-control setting-value"
                                                           value="@setting.Value"
                                                           data-setting-key="@setting.Key"
                                                           autocomplete="new-password" />

                                                    <button type="button"
                                                            class="btn btn-outline-secondary setting-secret-toggle"
                                                            title="نمایش/مخفی کردن">
                                                        <i class="material-icons">visibility</i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <input type="text"
                                                       class="form-control setting-value"
                                                       value="@setting.Value"
                                                       data-setting-key="@setting.Key" />
                                            }

                                            break;

                                        case SettingValueType.Int:
                                            <input type="number"
                                                   class="form-control"
                                                   value="@setting.Value"
                                                   data-setting-key="@setting.Key"
                                                   step="1" />
                                            break;

                                        case SettingValueType.Long:
                                            <input type="number"
                                                   class="form-control"
                                                   value="@setting.Value"
                                                   data-setting-key="@setting.Key"
                                                   step="1" />
                                            break;

                                        case SettingValueType.Decimal:
                                            <input type="number"
                                                   class="form-control"
                                                   value="@setting.Value"
                                                   data-setting-key="@setting.Key"
                                                   step="any" />
                                            break;

                                        case SettingValueType.Boolean:
                                            <div class="form-check form-switch">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       data-setting-key="@setting.Key"
                                                       @(bool.TryParse(setting.Value, out var boolValue) && boolValue
                                                                                              ? "checked"
                                                                                              : null) />
                            </div>
                                                        break;

                                        case SettingValueType.DateTime:

                                            <div class="setting-datetime-wrapper">

                                                <div class="row g-2">
                                                    <div class="col-md-8">

                                                        <input type="text"
                                                            class="form-control persian-date-picker"
                                                               value="@setting.DisplayValue">
                                                    </div>

                                                    <div class="col-md-4">
                                                        <input type="time"
                                                               class="form-control setting-time-input"
                                                               step="1"
                                                               data-setting-key="@setting.DisplayExValue" />
                                                    </div>

                                                </div>

                                                <input type="hidden"
                                                       name="settings[@setting.Key]"
                                                       class="setting-gregorian-value"
                                                       value="@setting.InputValue"
                                                       data-setting-key="@setting.Key" />
                                            </div>

                                            break;

                                        case SettingValueType.TimeSpan:
                                            <input type="text"
                                                   class="form-control"
                                                   value="@setting.Value"
                                                   data-setting-key="@setting.Key"
                                                   placeholder="HH:mm:ss" />
                                            break;

                                        case SettingValueType.Json:
                                            <textarea class="form-control font-monospace"
                                      rows="6"
                                      data-setting-key="@setting.Key">@setting.Value</textarea>
                                            break;

                                        default:
                                            <input type="text"
                                                   class="form-control"
                                                   value="@setting.Value"
                                                   data-setting-key="@setting.Key" />
                                            break;
                                    }

                                </div>

                                <div class="col-lg-2 text-lg-end mt-3 mt-lg-0">

                                    <button type="button"
                                            class="btn btn-primary btn-sm setting-save-btn"
                                            data-setting-key="@setting.Key">
                                        ذخیره
                                    </button>

                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
</div>