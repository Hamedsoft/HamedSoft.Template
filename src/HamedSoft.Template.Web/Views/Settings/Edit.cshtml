@using HamedSoft.Template.Domain.Settings
@model HamedSoft.Template.Web.ViewModels.Settings.SettingEditViewModel

@{
    ViewData["Title"] = "Edit Setting";
}

<div class="container-fluid">

    <div class="card">

        <div class="card-header">
            <h4 class="mb-0">Edit Setting</h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Key" type="hidden" />
                <input asp-for="Id" type="hidden" />
                <input asp-for="IsSecret" type="hidden" />
                <input asp-for="ValueType" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Module</label>
                        <input value="@Model.Module"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Feature</label>
                        <input value="@Model.Feature"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Category</label>
                        <input value="@Model.Category"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Key</label>
                        <input value="@Model.Key"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Value Type</label>
                        <input value="@Model.ValueType"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Default Value</label>
                        <input value="@Model.DefaultValue"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-12 mb-3">

                        <label asp-for="Value"
                               class="form-label">
                            Value
                        </label>

                        @if (Model.IsSecret)
                        {
                            <input asp-for="Value"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Leave empty to keep the current value" />
                        }
                        else
                        {
                            switch (Model.ValueType)
                            {
                                case SettingValueType.String:

                                    <input asp-for="Value"
                                           type="text"
                                           class="form-control" />

                                    break;

                                case SettingValueType.Int:

                                    <input asp-for="Value"
                                           type="number"
                                           step="1"
                                           class="form-control" />

                                    break;

                                case SettingValueType.Long:

                                    <input asp-for="Value"
                                           type="number"
                                           step="1"
                                           class="form-control" />

                                    break;

                                case SettingValueType.Decimal:

                                    <input asp-for="Value"
                                           type="number"
                                           step="any"
                                           class="form-control" />

                                    break;

                                case SettingValueType.Boolean:

                                    <select asp-for="Value"
                                            class="form-select">

                                        <option value="true">True</option>
                                        <option value="false">False</option>

                                    </select>

                                    break;

                                case SettingValueType.DateTime:

                                    <input asp-for="Value"
                                           type="datetime-local"
                                           class="form-control" />

                                    break;

                                case SettingValueType.TimeSpan:

                                    <input asp-for="Value"
                                           type="text"
                                           class="form-control"
                                           placeholder="hh:mm:ss" />

                                    break;

                                case SettingValueType.Json:

                                    <textarea asp-for="Value"
                                              class="form-control"
                                              rows="8"
                                              spellcheck="false"></textarea>

                                    break;

                                default:

                                    <input asp-for="Value"
                                           type="text"
                                           class="form-control" />

                                    break;
                            }
                        }

                        <span asp-validation-for="Value"
                              class="text-danger"></span>

                        @if (Model.IsSecret)
                        {
                            <div class="form-text">
                                Leave empty to keep the current secret value.
                            </div>
                        }

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="col-12 mb-3">

                            <label class="form-label">
                                Description
                            </label>

                            <div class="alert alert-secondary">
                                @Model.Description
                            </div>

                        </div>
                    }

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}