@model HamedSoft.Template.Web.ViewModels.Auth.RegisterViewModel
@{
    Layout = "_Login";
    ViewData["Title"] = "ثبت نام";
}

<div class="wrap-login100 col-md-9 pt-7">
    <form asp-action="Register" method="post">
        <span class="login100-form-title pb-5">
            @ViewData["Title"]
        </span>
        <div class="panel panel-primary">
            <div class="panel-body tabs-menu-body p-0 pt-5">
                <div class="tab-pane active" id="tab5">
                    <div class="row">
                        <div class="col-sm-6 col-md-4 mt-2">
                            <div class="form-group mb-0">
                                <span class="text-red m-lg-1">*</span>
                                <label asp-for="FirstName" class="mt-2"></label>
                                <div class="wrap-input100 validate-input input-group">
                                    <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                        <i class="zmdi zmdi-pin-account text-muted" aria-hidden="true"></i>
                                    </a>
                                    <input asp-for="FirstName" class="input100 border-start-0 form-control ms-0" placeholder="نام" />
                                </div>
                            </div>
                            <div class="bg-danger-transparent-2 text-danger mt-0">
                                <span asp-validation-for="FirstName"></span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4 mt-2">
                            <div class="form-group mb-0">
                                <span class="text-red m-lg-1">*</span>
                                <label asp-for="LastName" class="mt-2"></label>
                                <div class="wrap-input100 validate-input input-group">
                                    <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                        <i class="zmdi zmdi-pin-account text-muted" aria-hidden="true"></i>
                                    </a>
                                    <input asp-for="LastName" class="input100 border-start-0 form-control ms-0" placeholder="نام خانوادگی" />
                                </div>
                            </div>
                            <div class="bg-danger-transparent-2 text-danger mt-0">
                                <span asp-validation-for="LastName"></span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4 mt-2">
                        </div>

                        <div class="col-sm-6 col-md-4 mt-2">
                            <div class="form-group mb-0">
                                <span class="text-red m-lg-1">*</span>
                                <label asp-for="UserName" class="mt-2"></label>
                                <div class="wrap-input100 validate-input input-group">
                                    <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                        <i class="zmdi zmdi-pin-account text-muted" aria-hidden="true"></i>
                                    </a>
                                    <input asp-for="UserName" class="input100 border-start-0 form-control ms-0" placeholder="نام کاربری" />
                                </div>
                            </div>
                            <div class="bg-danger-transparent-2 text-danger mt-0">
                                <span asp-validation-for="UserName"></span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4 mt-2">
                            <div class="form-group mb-0">
                                <span class="text-red m-lg-1">*</span>
                                <label asp-for="Password" class="mt-2"></label>
                                <div class="wrap-input100 validate-input input-group" id="Password-toggle">
                                    <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                        <i class="zmdi zmdi-eye text-muted" aria-hidden="true"></i>
                                    </a>
                                    <input asp-for="Password" class="input100 border-start-0 form-control ms-0" type="password" placeholder="کلمه عبور" autocomplete="current-password" />
                                </div>
                            </div>
                            <div class="bg-danger-transparent-2 text-danger mt-0">
                                <span asp-validation-for="Password"></span>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4 mt-2">
                            <div class="form-group mb-0">
                                <span class="text-red m-lg-1">*</span>
                                <label asp-for="ConfirmPassword" class="mt-2"></label>
                                <div class="wrap-input100 validate-input input-group" id="ConfirmPassword-toggle">
                                    <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                        <i class="zmdi zmdi-eye text-muted" aria-hidden="true"></i>
                                    </a>
                                    <input asp-for="ConfirmPassword" class="input100 border-start-0 form-control ms-0" type="Password" placeholder="تکرار کلمه عبور" autocomplete="current-password" />
                                </div>
                            </div>
                            <div class="bg-danger-transparent-2 text-danger mt-0">
                                <span asp-validation-for="ConfirmPassword"></span>
                            </div>
                        </div>
                    </div>


                    <div class="container-login100-form-btn mt-6">
                        <div class="row justify-content-center w-100 g-2">
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">ثبت نام</button>
                            </div>

                            <div class="col-md-2">
                                <a asp-action="Login" class="btn btn-info w-100">ورود</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
