@model HamedSoft.Template.Web.ViewModels.Auth.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغییر کلمه عبور";
}
<form asp-controller="Account" asp-action="ChangePassword" method="post">
    <div class="row justify-content-center">
        <div class="card col-md-4">
            <div class="card-header">
                <h3 class="card-title">@ViewData["Title"]</h3>
            </div>
            <div class="card-body pb-2">
                <div class="col-md-12 mt-2">
                    <div class="form-group mb-0">
                        <span class="text-red m-lg-1">*</span>
                        <label asp-for="CurrentPassword" class="mt-2"></label>
                        <div class="wrap-input100 validate-input input-group" id="CurrentPassword-toggle">
                            <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                <i class="zmdi zmdi-eye text-muted" aria-hidden="true"></i>
                            </a>
                            <input asp-for="CurrentPassword" class="input100 border-start-0 form-control ms-0" type="password" placeholder="کلمه عبور" />
                        </div>
                    </div>
                    <div class="bg-danger-transparent-2 text-danger mt-0">
                        <span asp-validation-for="CurrentPassword"></span>
                    </div>
                </div>
                <div class="col-md-12 mt-2">
                    <div class="form-group mb-0">
                        <span class="text-red m-lg-1">*</span>
                        <label asp-for="NewPassword" class="mt-2"></label>
                        <div class="wrap-input100 validate-input input-group" id="CurrentPassword-toggle">
                            <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                <i class="zmdi zmdi-eye text-muted" aria-hidden="true"></i>
                            </a>
                            <input asp-for="NewPassword" class="input100 border-start-0 form-control ms-0" type="password" placeholder="کلمه عبور جدید" />
                        </div>
                    </div>
                    <div class="bg-danger-transparent-2 text-danger mt-0">
                        <span asp-validation-for="NewPassword"></span>
                    </div>
                </div>
                <div class="col-md-12 mt-2">
                    <div class="form-group mb-0">
                        <span class="text-red m-lg-1">*</span>
                        <label asp-for="ConfirmPassword" class="mt-2"></label>
                        <div class="wrap-input100 validate-input input-group" id="CurrentPassword-toggle">
                            <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                <i class="zmdi zmdi-eye text-muted" aria-hidden="true"></i>
                            </a>
                            <input asp-for="ConfirmPassword" class="input100 border-start-0 form-control ms-0" type="password" placeholder="تکرار کلمه عبور جدید" />
                        </div>
                    </div>
                    <div class="bg-danger-transparent-2 text-danger mt-0">
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
            </div>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-6"> </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">تغییر کلمه عبور</button>
                <a asp-controller="Home" asp-action="index" class="btn btn-default">بازگشت</a>
            </div>
        </div>
    </div>
</form>
