@using Microsoft.AspNetCore.WebUtilities

@model HamedSoft.Template.Web.ViewModels.Common.Pagination.PaginationViewModel

@{
    string BuildUrl(int pageNumber)
    {
        var query = new Dictionary<string, string?>();

        if (!string.IsNullOrWhiteSpace(Model.ActiveTab))
        {
            query["activeTab"] = Model.ActiveTab;
        }

        if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            query["search"] = Model.Search;
        }

        if (Model.PageSize > 0)
        {
            query[Model.PageSizeParameterName] =
                Model.PageSize.ToString();
        }

        query[Model.PageParameterName] =
            pageNumber.ToString();

        foreach (var parameter in Model.AdditionalParameters)
        {
            query[parameter.Key] = parameter.Value;
        }

        var url = Url.Action(
            Model.Action,
            Model.Controller);

        return QueryHelpers.AddQueryString(
            url ?? string.Empty,
            query);
    }
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Pagination">
        <ul class="pagination justify-content-center">

            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@BuildUrl(Model.PageNumber - 1)">
                        <i class="fa fa-angle-right"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">
                        <i class="fa fa-angle-right"></i>
                    </span>
                </li>
            }

            @for (var spage = 1; spage <= Model.TotalPages; spage++)
            {
                <li class="page-item @(spage == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       href="@BuildUrl(spage)">
                        @spage
                    </a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@BuildUrl(Model.PageNumber + 1)">
                        <i class="fa fa-angle-left"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">
                        <i class="fa fa-angle-left"></i>
                    </span>
                </li>
            }

        </ul>
    </nav>
}