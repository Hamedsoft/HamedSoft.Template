@using Microsoft.AspNetCore.WebUtilities

@model HamedSoft.Template.Web.ViewModels.Common.Pagination.PaginationViewModel

@{
    string BuildUrl(int pageNumber, int? pageSize = null)
    {
        var query = new Dictionary<string, string?>();

        if (!string.IsNullOrWhiteSpace(Model.ActiveTab))
        {
            query["activeTab"] = Model.ActiveTab;
        }

        if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            query["search"] = Model.Search;
        }

        if (pageSize.HasValue && pageSize.Value > 0)
        {
            query[Model.PageSizeParameterName] =
                pageSize.Value.ToString();
        }
        else if (Model.PageSize > 0)
        {
            query[Model.PageSizeParameterName] =
                Model.PageSize.ToString();
        }

        query[Model.PageParameterName] =
            pageNumber.ToString();

        foreach (var parameter in Model.AdditionalParameters)
        {
            query[parameter.Key] = parameter.Value;
        }

        var url = Url.Action(
            Model.Action,
            Model.Controller);

        return QueryHelpers.AddQueryString(
            url ?? string.Empty,
            query);
    }

    IEnumerable<int> GetVisiblePages()
    {
        if (Model.TotalPages <= 7)
        {
            for (var page = 1; page <= Model.TotalPages; page++)
            {
                yield return page;
            }

            yield break;
        }

        if (Model.PageNumber <= 4)
        {
            for (var page = 1; page <= 5; page++)
            {
                yield return page;
            }

            yield return -1;
            yield return Model.TotalPages;

            yield break;
        }

        if (Model.PageNumber >= Model.TotalPages - 3)
        {
            yield return 1;
            yield return -1;

            for (
                var page = Model.TotalPages - 4;
                page <= Model.TotalPages;
                page++)
            {
                yield return page;
            }

            yield break;
        }

        yield return 1;
        yield return -1;

        yield return Model.PageNumber - 1;
        yield return Model.PageNumber;
        yield return Model.PageNumber + 1;

        yield return -1;
        yield return Model.TotalPages;
    }

    var firstItem =
        Model.TotalCount == 0
            ? 0
            : ((Model.PageNumber - 1) * Model.PageSize) + 1;

    var lastItem =
        Math.Min(
            Model.PageNumber * Model.PageSize,
            Model.TotalCount);
}

@if (Model.TotalPages > 0)
{
    <div class="mt-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="text-muted">
                @if (Model.TotalCount == 0)
                {
                    <span>ردیفی برای نمایش وجود ندارد.</span>
                }
                else
                {
                    <span>
                        نمایش @firstItem تا @lastItem از @Model.TotalCount
                    </span>
                }
            </div>

            <div class="d-flex align-items-center gap-2">

                <span class="text-muted">
                    نمایش
                </span>

                <select class="form-select form-select-sm pe-sm-0 text-center"
                        style="width: 55px; min-width: 55px;"
                        onchange="window.location.href = this.value;">

                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        <option value="@BuildUrl(1, size)"
                                selected="@(Model.PageSize == size)">
                            @size
                        </option>
                    }

                </select>

                <span class="text-muted">
                    ردیف در هر صفحه
                </span>

            </div>

        </div>


        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3"
                 aria-label="Pagination">

                <ul class="pagination justify-content-center mb-0">

                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               href="@BuildUrl(Model.PageNumber - 1)"
                               aria-label="صفحه قبل">

                                <i class="fa fa-angle-left"></i>

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                <i class="fa fa-angle-left"></i>
                            </span>

                        </li>
                    }


                    @foreach (var spage in GetVisiblePages())
                    {
                        @if (spage == -1)
                        {
                            <li class="page-item disabled">

                                <span class="page-link">
                                    ...
                                </span>

                            </li>
                        }
                        else
                        {
                            <li class="page-item @(spage == Model.PageNumber ? "active" : "")">

                                @if (spage == Model.PageNumber)
                                {
                                    <span class="page-link">
                                        @spage
                                    </span>
                                }
                                else
                                {
                                    <a class="page-link"
                                       href="@BuildUrl(spage)">
                                        @spage
                                    </a>
                                }

                            </li>
                        }
                    }


                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               href="@BuildUrl(Model.PageNumber + 1)"
                               aria-label="صفحه بعد">

                                <i class="fa fa-angle-right"></i>

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                <i class="fa fa-angle-right"></i>
                            </span>

                        </li>
                    }

                </ul>

            </nav>
        }

    </div>
}