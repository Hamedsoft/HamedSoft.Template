@using HamedSoft.Template.Application.Contracts.Security
@inject ICurrentUser _CurrentUser

<div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
    <div class="drop-heading">
        <div class="text-center">
            <h5 class="text-dark mb-0 fs-14 fw-semibold">@_CurrentUser.DisplayName</h5>
            <small class="text-muted">@string.Join("، ", _CurrentUser.Roles)</small>
        </div>
    </div>
    <div class="dropdown-divider m-0"></div>
    <a class="dropdown-item" asp-controller="Users" asp-action="UserProfile">
        <i class="dropdown-icon fe fe-user"></i> پروفایل
    </a>
    <a class="dropdown-item" href="lockscreen.html">
        <i class="dropdown-icon fe fe-lock"></i> تغییر کلمه عبور
    </a>
    <form asp-action="Logout" asp-controller="Account" method="post">
        <button type="submit" class="dropdown-item border-0 bg-transparent w-100 text-start">
            <i class="dropdown-icon fe fe-alert-circle"></i>
            خروج
        </button>
    </form>
</div>