@model HamedSoft.Template.Web.ViewModels.Users.UserProfileViewModel


<form asp-action="UpdateProfile"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="UserId" />


    <div class="mb-3">

        <label class="form-label">
            نام کاربری
        </label>

        <input class="form-control"
               asp-for="UserName"
               readonly />

    </div>


    <div class="mb-3">

        <label class="form-label">
            نام
        </label>

        <input class="form-control"
               asp-for="FirstName" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            نام خانوادگی
        </label>

        <input class="form-control"
               asp-for="LastName" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            Email
        </label>

        <input class="form-control"
               asp-for="Email" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            شماره تماس
        </label>

        <input class="form-control"
               asp-for="PhoneNumber" />

    </div>


    <button type="submit"
            class="btn btn-primary">

        ذخیره اطلاعات

    </button>

</form>