@model HamedSoft.Template.Web.ViewModels.Users.UserProfileViewModel
<form asp-action="UpdateProfile" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="UserName" />
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                اطلاعات پروفایل
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6 col-md-6">
                    <div class="form-group">
                        <div class="d-flex align-items-center">
                            <span class="text-red">*</span>
                            <label asp-for="FirstName" class="form-label ms-1"></label>
                        </div>
                        <input class="form-control" asp-for="FirstName" placeholder="نام" />
                    </div>
                </div>
                <div class="col-sm-6 col-md-6">
                    <div class="form-group">
                        <div class="d-flex align-items-center">
                            <span class="text-red">*</span>
                            <label asp-for="LastName" class="form-label ms-1"></label>
                        </div>
                        <input class="form-control" asp-for="LastName" placeholder="نام خانوادگی" />
                    </div>
                </div>
                <div class="col-sm-6 col-md-6">
                    <div class="form-group">
                        <div class="d-flex align-items-center">
                            <label asp-for="Email" class="form-label mb-0"></label>
                        </div>
                        <input class="form-control" asp-for="Email" placeholder="ایمیل" />
                    </div>
                </div>
                <div class="col-sm-6 col-md-6">
                    <div class="form-group">
                        <div class="d-flex align-items-center">
                            <label asp-for="PhoneNumber" class="form-label mb-0"></label>
                        </div>
                        <input class="form-control" asp-for="PhoneNumber" placeholder="شماره موبایل" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-success">ذخیره اطلاعات</button>
            <a class="btn btn-default" asp-action="index" asp-controller="Home">بازگشت</a>
        </div>
    </div>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-6"> </div>
</form>

