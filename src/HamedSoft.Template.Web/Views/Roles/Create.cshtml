@model HamedSoft.Template.Web.ViewModels.Roles.CreateRoleViewModel

@{
    ViewData["Title"] = "ایجاد نقش";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">ایجاد نقش جدید</h5>
    </div>

    <div class="card-body">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="RoleName"
                       class="form-label">
                    نام نقش
                </label>

                <input asp-for="RoleName"
                       class="form-control"
                       autocomplete="off" />

                <span asp-validation-for="RoleName"
                      class="text-danger">
                </span>
            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    ایجاد
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    انصراف
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}