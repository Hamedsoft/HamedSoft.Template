@model HamedSoft.Template.Web.ViewModels.Roles.CreateRoleViewModel
@{
    ViewData["Title"] = "ایجاد نقش";
}

<form asp-controller="Roles" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="row justify-content-center">
        <div class="card col-md-4">
            <div class="card-header">
                <h3 class="card-title">@ViewData["Title"]</h3>
            </div>
            <div class="card-body pb-2">
                <div class="col-md-12 mt-2">
                    <div class="form-group mb-0">
                        <span class="text-red m-lg-1">*</span>
                        <label asp-for="RoleName" class="mt-2"></label>
                        <div class="wrap-input100 validate-input input-group" id="RoleName-toggle">
                            <a href="javascript:void(0)" class="input-group-text bg-white text-muted">
                                <i class="zmdi zmdi-eye text-muted" aria-hidden="true"></i>
                            </a>
                            <input asp-for="RoleName" class="input100 border-start-0 form-control ms-0" placeholder="نام نقش" />
                        </div>
                    </div>
                    <div class="bg-danger-transparent-2 text-danger mt-0">
                        <span asp-validation-for="RoleName"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">ذخیره</button>
                <a asp-controller="Roles" asp-action="index" class="btn btn-default">انصراف</a>
            </div>
        </div>
    </div>
</form>
