@model HamedSoft.Template.Web.ViewModels.Roles.RolePermissionViewModel


<h2>
    دسترسی‌های نقش @Model.RoleName
</h2>


<form asp-action="Permissions"
      method="post">


    <input type="hidden"
           asp-for="RoleId" />


    @foreach (var permission in Model.Permissions)
    {
        <div class="form-check">

            <input class="form-check-input"
                   type="checkbox"
                   name="PermissionIds"
                   value="@permission.PermissionId"
                   checked="@permission.IsAssigned" />

            <label class="form-check-label">
                @permission.Name
            </label>

        </div>
    }


    <button class="btn btn-success mt-3"
            type="submit">
        ذخیره
    </button>

</form>