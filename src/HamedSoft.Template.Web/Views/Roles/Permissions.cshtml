@model HamedSoft.Template.Web.ViewModels.Roles.RolePermissionViewModel

<form asp-controller="Roles"
      asp-action="Permissions"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="RoleId" />

    <div class="text-muted mb-4">
        نقش:
        <strong>@Model.RoleName</strong>
    </div>

    @if (!Model.Permissions.Any())
    {
        <div class="alert alert-warning">
            هیچ Permissionای برای سیستم تعریف نشده است.
        </div>
    }
    else
    {
        var modules = Model.Permissions
        .GroupBy(x => x.Module)
        .OrderBy(x => x.Key);

        foreach (var module in modules)
        {
            <div class="card mb-4">

                <div class="card-header">
                    <h5 class="mb-0">
                        @module.Key
                    </h5>
                </div>

                <div class="card-body">

                    @foreach (var category in module
                                .GroupBy(x => x.Category)
                                .OrderBy(x => x.Key))
                    {
                        <div class="mb-4">

                            <h6 class="border-bottom pb-2 mb-3">
                                @category.Key
                            </h6>

                            <div class="row">

                                @foreach (var permission in category)
                                {
                                    <div class="col-md-6 col-lg-4 mb-3">

                                        <div class="form-check">

                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="PermissionIds"
                                                   value="@permission.PermissionId"
                                                   checked="@permission.IsAssigned" />

                                            <label class="form-check-label">
                                                @permission.DisplayName
                                            </label>

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                permission.Description))
                                        {
                                            <small class="text-muted ms-4">
                                                @permission.Description
                                            </small>
                                        }

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>
            </div>
        }
    }

    <div class="mt-3">
        <button class="btn btn-success"
                type="submit">
            ذخیره دسترسی‌ها
        </button>
    </div>

</form>
