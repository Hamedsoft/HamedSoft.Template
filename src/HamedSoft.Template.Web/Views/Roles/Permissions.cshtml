@model HamedSoft.Template.Web.ViewModels.Roles.RolePermissionViewModel
<form asp-controller="Roles" asp-action="Permissions" method="post">
	<div class="text-muted mb-4">نقش: <strong>@Model.RoleName</strong></div>
	<div class="card">
		<div class="card-footer text-end">
			@Html.AntiForgeryToken()
			<input type="hidden" asp-for="RoleId" />
			<div class="mt-3">
				<button class="btn btn-success" type="submit">ذخیره</button>
				<a class="btn btn-default" type="button" asp-action="index">انصراف</a>
			</div>
		</div>
	</div>
	<div class="row">
		@{
			var modules = Model.Permissions.GroupBy(x => x.Module).OrderBy(x => x.Key);
			foreach (var module in modules)
			{
				<div class="col-sm-6 col-md-6 col-lg-6 col-xl-6">
					<div class="card">
						<div class="card-header justify-content-center m-0 pb-0 pt-2">
							<p class="mb-2 ms-2">@module.Key</p>
						</div>

						<ul class="transfer-double-group-list-ul transfer-double-group-list-ul-1786416773614">

							<li class="transfer-double-group-list-li transfer-double-group-list-li-1786416773614">

								<ul class="transfer-double-group-list-li-ul transfer-double-group-list-li-ul-1786416773614">

									<li class="transfer-double-group-list-li-ul-li transfer-double-group-list-li-ul-li-1786416773614">
										@foreach (var category in module.GroupBy(x => x.Category).OrderBy(x => x.Key))
										{
											<div class="row custom-controls-stacked">
												<label class="custom-switch form-switch mb-2 ms-5 mt-3">
													@category.Key
												</label>
												@foreach (var permission in category)
												{
													<label class="custom-switch form-switch mb-2 ms-6">
														<input class="custom-switch-input" type="checkbox" name="PermissionIds" value="@permission.PermissionId" checked="@permission.IsAssigned" />
														<span class="custom-switch-indicator"></span>
														<span class="form-check-label ms-2">@permission.DisplayName</span>
													</label>
													<label class="row mt-0 mb-4 pt-0 ms-6">
														<span class="text-muted sm ms-6">@permission.Description</span>
													</label>
												}
											</div>
										}
									</li>
								</ul>
							</li>
						</ul>
					</div>
				</div>
			}
		}
	</div>
</form>
