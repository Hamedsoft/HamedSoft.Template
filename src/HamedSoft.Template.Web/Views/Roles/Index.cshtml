@using HamedSoft.Template.Application.Security
@model IReadOnlyList<HamedSoft.Template.Application.Contracts.Roles.RoleDto>

@{
    ViewData["Title"] = "لیست نقش ها";
}
<div class="row justify-content-center">
    <div class="card col-md-12">

        <div class="card-header">
            <h3 class="card-title">@ViewData["Title"]</h3>
        </div>
        <div class="card-body">
            <permission require="@PermissionConstants.Roles.Edit">
                <a asp-action="Create" class="btn btn-sm btn-success"><i class="fa fa-user-plus me-2"></i>جدید</a>
            </permission>
            <div class="table-responsive">
                <table class="table border text-nowrap text-md-nowrap table-striped mb-0 mt-2">
                    <thead>
                        <tr>
                            <th>نام نقش</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td>@role.RoleName</td>
                                <td>
                                    <permission require="@PermissionConstants.Roles.Edit">
                                        <a asp-action="Edit" asp-route-id="@role.RoleId" class="btn btn-sm btn-warning"><i class="fa fa fa-pencil me-2"></i>ویرایش</a>
                                    </permission>
                                    <permission require="@PermissionConstants.Roles.AssignPermissions">
                                        <a asp-action="Permissions" asp-route-id="@role.RoleId" class="btn btn-sm btn-primary"><i class="fa fa fa fa-shield me-2"></i>دسترسی‌ها</a>
                                    </permission>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
