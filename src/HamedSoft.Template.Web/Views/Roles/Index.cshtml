@using HamedSoft.Template.Application.Security
@using HamedSoft.Template.Web.ViewModels.Roles

@model RolesIndexViewModel
@{
    ViewData["Title"] = "لیست نقش ها";
}
<div class="row justify-content-center">
    <div class="card col-md-12">

        <div class="card-header">
            <h3 class="card-title">@ViewData["Title"]</h3>
        </div>
        <form asp-action="Index" method="get" class="mb-4">
            <div class="row align-items-end pt-2">

                <div class="col-md-5">
                    <a asp-action="Index" class="form-label text-decoration-none mb-1 ms-5" title="حذف فیلتر">جستجو</a>
                    <div class="input-group ms-5 ">
                        <input type="text"
                               class="form-control"
                               name="search"
                               value="@Model.Search"
                               placeholder="نام نقش"
                               autocomplete="off"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                        <button class="btn btn-light" type="submit" id="button-addon1"><i class="fe fe-search" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>
        </form>
        <div class="card-body">
            <permission require="@PermissionConstants.Roles.Edit">
                <a asp-action="Create" class="btn btn-sm btn-success"><i class="fe fe-plus-circle me-2"></i>جدید</a>
            </permission>
            <div class="table-responsive">
                <table class="table border text-nowrap text-md-nowrap table-striped mb-0 mt-2">
                    <thead>
                        <tr>
                            <th>نام نقش</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model.Roles.Items)
                        {
                            <tr>
                                <td>@role.RoleName</td>
                                <td>
                                    @if (!role.IsAdmin)
                                    {
                                        <permission require="@PermissionConstants.Roles.Edit">
                                            <a asp-action="Edit" asp-route-id="@role.RoleId" class="btn btn-sm btn-warning"><i class="fa fa fa-pencil me-2"></i>ویرایش</a>
                                        </permission>
                                        <permission require="@PermissionConstants.Roles.AssignPermissions">
                                            <a asp-action="Permissions" asp-route-id="@role.RoleId" class="btn btn-sm btn-primary"><i class="fa fa fa fa-shield me-2"></i>دسترسی‌ها</a>
                                        </permission>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @await Html.PartialAsync("_Pagination", Model.Pagination)
            </div>
        </div>
    </div>
</div>
