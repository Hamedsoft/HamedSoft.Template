@using HamedSoft.Template.Application.Security
@model IReadOnlyList<HamedSoft.Template.Application.Contracts.Roles.RoleDto>

<h2 class="mb-4">
    مدیریت نقش‌ها
</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>نقش‌ها</h4>

    <permission require="@PermissionConstants.Roles.Create">
        <a asp-action="Create"
           class="btn btn-primary">
            ایجاد نقش جدید
        </a>
    </permission>
</div>
<table class="table table-bordered">

    <thead>
        <tr>
            <th>
                نام نقش
            </th>

            <th>
                عملیات
            </th>
        </tr>
    </thead>


    <tbody>

        @foreach (var role in Model)
        {
            <tr>
                <td>
                    @role.RoleName
                </td>

                <td>
                    <permission require="@PermissionConstants.Roles.Edit">
                        <a asp-action="Edit"
                           asp-route-id="@role.RoleId"
                           class="btn btn-sm btn-warning">
                            ویرایش
                        </a>
                    </permission>

                    <permission require="@PermissionConstants.Roles.AssignPermissions">
                        <a asp-action="Permissions"
                           asp-route-id="@role.RoleId"
                           class="btn btn-sm btn-info">
                            دسترسی‌ها
                        </a>
                    </permission>

                    <permission require="@PermissionConstants.Roles.Delete">
                        <form asp-action="Delete"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('آیا از حذف این نقش مطمئن هستید؟');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@role.RoleId" />

                            <button type="submit"
                                    class="btn btn-sm btn-danger">
                                حذف
                            </button>
                        </form>
                    </permission>
                </td>
            </tr>
        }

    </tbody>

</table>