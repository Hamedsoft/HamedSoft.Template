{
    "ConnectionStrings": {
        "DefaultConnection": "Server=.;Database=HamedSoft.Template;Trusted_Connection=True;TrustServerCertificate=True"
    },
    "Identity": {
        "AdminUser": {
            "UserName": "admin",
            "Password": "Admin@123456",
            "FirstName": "حامد",
            "LastName": "ضیائی"
        },
        "ManagerUser": {
            "UserName": "Manager",
            "Password": "123@123",
            "FirstName": "مدیر",
            "LastName": "سیستم"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext"
        ],
        "Properties": {
            "Application": "HamedSoft.Template"
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] CorrelationId={CorrelationId} UserId={UserId} RequestPath={RequestPath} HttpMethod={HttpMethod} {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/app-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] CorrelationId={CorrelationId} UserId={UserId} RequestPath={RequestPath} HttpMethod={HttpMethod} {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
